{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "@contracts": [
        "./typechain-types"
      ],
      "@contracts/*": [
        "./types/typechain-types/contracts/*"
      ],
      "@utils": [
        "./utils/index.ts"
      ],
      "@test-utils": [
        "./test/utils"
      ]
    }
  }
}