{
  "name": "upgradeable-erc20",
  "scripts": {
    "compile": "hardhat compile --force",
    "coverage": "hardhat coverage",
    "gas-reporter": "ENABLE_GAS_REPORT=true hardhat test",
    "prepare": "husky",
    "test": "hardhat test ./test/index.test.ts",
    "test:node": "hardhat test --network localhost ./test/index.test.ts",
    "lint": "yarn lint:ts && yarn lint:sol",
    "lint:fix": "yarn lint:ts:fix && yarn lint:sol:fix",
    "lint:ts": "eslint --ext .ts .",
    "lint:ts:fix": "eslint --ext .ts . --fix",
    "lint:sol": "solhint -f table '{contracts,test}/**/*.sol' && prettier --check --plugin=prettier-plugin-solidity 'contracts/**/*.sol'",
    "lint:sol:fix": "npx prettier --write --plugin=prettier-plugin-solidity 'contracts/**/*.sol'",
    "ignition:polygon": "hardhat ignition deploy --network polygon",
    "ignition:polygonAmoy": "hardhat ignition deploy --network polygonAmoy",
    "verify:polygon": "npx hardhat ignition verify chain-137",
    "verify:polygonAmoy": "npx hardhat ignition verify chain-80002"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "^5.3.0",
    "@openzeppelin/contracts-upgradeable": "^5.3.0",
    "@openzeppelin/hardhat-upgrades": "^3.9.0",
    "@typescript-eslint/eslint-plugin": "^6.20.0",
    "@typescript-eslint/parser": "^6.20.0",
    "config": "^4.0.0",
    "dotenv": "^16.5.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-promise": "^6.1.1",
    "ethers": "^6.14.1",
    "hardhat": "^2.24.0",
    "husky": "^9.1.7",
    "prettier": "^3.3.3",
    "prettier-plugin-solidity": "^1.4.1",
    "solhint": "^4.1.1",
    "solhint-plugin-prettier": "^0.1.0",
    "tsconfig-paths": "^4.2.0"
  }
}